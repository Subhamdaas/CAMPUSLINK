# =============================================================
# CAMPUSLINK - MYSQL DATABASE & SERVER ENVIRONMENT CONFIG
# =============================================================

# Server Port
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campuslink_db

# Security & JWT Token Secret
JWT_SECRET=campuslink_super_secret_enterprise_jwt_key_2026
JWT_EXPIRES_IN=7d

# Email Configuration (for Gmail OTP Password Reset)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_char_app_password
EMAIL_FROM="CampusLink Verification <no-reply@campuslink.edu>"

